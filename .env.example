# Application
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret
ADMIN_X_IDS=

# X OAuth 2.0 (owner-provided)
X_CLIENT_ID=
X_CLIENT_SECRET=

# Database and queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pons_game_studio
REDIS_URL=

# Wallets and Robinhood Chain
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Browser-safe RPC. This value is exposed to visitors.
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Server-only RPC for web and worker. When blank or unavailable, the server
# falls back to Robinhood's dRPC provider and then the official public RPC.
ROBINHOOD_RPC_URL=
NEXT_PUBLIC_PONS_V2_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
NEXT_PUBLIC_PONS_V2_LAUNCH_AND_BUY=0xe33E9E479dF8802cb0866d5d05258bEc4cF62948
PONS_FACTORY_DEPLOYMENT_BLOCK=
PONS_LAUNCH_ENABLED=true

# Free first launch: reimburses the exact verified Pons launch fee after confirmation.
# SPONSOR_ADDRESS is safe on the web service. Keep SPONSOR_PRIVATE_KEY on the worker only.
# Enabling rebates fails closed unless the address, per-launch cap, and rolling 24h budget are valid.
FREE_LAUNCH_REBATE_ENABLED=false
SPONSOR_ADDRESS=
SPONSOR_PRIVATE_KEY=
MAX_FREE_LAUNCH_REBATE_WEI=500000000000000
FREE_LAUNCH_DAILY_BUDGET_WEI=5000000000000000

# Optional Router Markets / OpenAI-compatible structured generation
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional S3-compatible immutable object storage. PostgreSQL storage is used when blank.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Phase gates
FEATURE_GOVERNANCE=false
FEATURE_TOURNAMENTS=false
